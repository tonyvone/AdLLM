# AdTech LLM Environment Configuration
# Copy this file to .env and configure your settings

# Application
APP_NAME=AdTech LLM
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adtech_llm
DB_USER=adtech
DB_PASSWORD=your_password_here
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vector Database
VECTOR_DB_PROVIDER=chromadb
VECTOR_DB_CHROMADB_PATH=./data/chromadb
# For Pinecone:
# VECTOR_DB_PROVIDER=pinecone
# VECTOR_DB_PINECONE_API_KEY=your_api_key
# VECTOR_DB_PINECONE_ENVIRONMENT=us-east-1
# VECTOR_DB_PINECONE_INDEX_NAME=adtech-llm

# LLM Configuration
LLM_PROVIDER=huggingface
LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_DEVICE=auto
LLM_QUANTIZATION=4bit
LLM_USE_FLASH_ATTENTION=true

# LoRA Fine-tuning
LLM_LORA_R=16
LLM_LORA_ALPHA=32
LLM_LORA_DROPOUT=0.05

# OpenAI (fallback)
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4-turbo-preview

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_MODELS_PATH=./data/models
DATA_CACHE_PATH=./data/cache

# Kaggle (for dataset downloads)
DATA_KAGGLE_USERNAME=
DATA_KAGGLE_KEY=

# Security
SECURITY_SECRET_KEY=your-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW=60

# Agent Configuration
AGENT_ORCHESTRATOR=langgraph
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300
AGENT_ENABLE_HUMAN_IN_LOOP=false
AGENT_PARALLEL_TASKS=4

# Monitoring
MONITORING_PROMETHEUS_PORT=9090
MONITORING_ENABLE_TRACING=true
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_FORMAT=json
